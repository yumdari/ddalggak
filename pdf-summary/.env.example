# 서버 전용. 절대 커밋하지 마세요. (.env.local 에 복사해서 사용, 값은 = 뒤에 따옴표 없이)

# 사용할 AI: gemini(기본, 무료 티어 가능) 또는 claude
AI_PROVIDER=gemini

# Gemini — https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# 선택: 모델명 (AI Studio에서 사용 가능한 모델 확인. 기본 gemini-2.5-flash)
# GEMINI_MODEL=

# Claude — AI_PROVIDER=claude 일 때만 필요
ANTHROPIC_API_KEY=
# 선택: 모델명 (기본 claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 1 이면 AI를 호출하지 않고 샘플 데이터로 화면만 확인. 실제 키를 쓸 때는 지우거나 0
# MOCK_AI=1
