# 이 파일은 커밋됩니다. 실제 키는 여기가 아니라 .env.local 에 넣으세요. (값은 = 뒤에 따옴표 없이)
# 서비스별 변수는 아래처럼 서비스 이름으로 구분해서 추가하세요.

# ===== study (강의자료 PDF 요약·퀴즈) =====
# 사용할 AI: gemini(기본, 무료 티어 가능) 또는 claude
AI_PROVIDER=gemini

# Gemini — https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# 선택: 모델명 (AI Studio에서 사용 가능한 모델 확인. 기본 gemini-3.8-flash)
# GEMINI_MODEL=
# 선택: 기본 모델이 붐빌 때(503/429) 넘어갈 대체 모델들 (쉼표로 구분)
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite

# Claude — AI_PROVIDER=claude 일 때만 필요
ANTHROPIC_API_KEY=
# 선택: 모델명 (기본 claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 1 이면 AI를 호출하지 않고 샘플 데이터로 화면만 확인. 실제 키를 쓸 때는 지우거나 0
# MOCK_AI=1
