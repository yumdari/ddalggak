# 이 파일은 커밋됩니다. 실제 키는 여기가 아니라 .env.local 에 넣으세요. (값은 = 뒤에 따옴표 없이)
# 서비스별 변수는 아래처럼 서비스 이름으로 구분해서 추가하세요.

# ===== 공통: Gemini API 키 (모든 서비스가 함께 사용) =====
# 키를 쉼표로 여러 개 넣으면 요청마다 돌려 쓰고, 한도(429)·과부하(503)·잘못된 키일 때 다음 키로 넘어간다.
# 서로 다른 구글 프로젝트에서 만든 키여야 한도가 따로 계산된다. 발급: https://aistudio.google.com
# (예전 방식인 GEMINI_API_KEY=키 하나 도 그대로 읽는다)
GEMINI_API_KEYS=

# ===== study (강의자료 PDF 요약·퀴즈) =====
# 사용할 AI: gemini(기본, 무료 티어 가능) 또는 claude
AI_PROVIDER=gemini

# 선택: 모델명 (AI Studio에서 사용 가능한 모델 확인. 기본 gemini-3.5-flash)
# GEMINI_MODEL=
# 선택: 기본 모델이 붐비거나 한도가 찰 때 넘어갈 대체 모델들 (쉼표로 구분)
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# Claude — AI_PROVIDER=claude 일 때만 필요
ANTHROPIC_API_KEY=
# 선택: 모델명 (기본 claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 1 이면 AI를 호출하지 않고 샘플 데이터로 화면만 확인. 실제 키를 쓸 때는 지우거나 0
# MOCK_AI=1

# ===== opportunities (기회 정보 큐레이션) =====
# Gemini 키는 위의 공통 GEMINI_API_KEYS를 함께 쓴다.
# 응답이 12초 안에 와야 AI 요약이 쓰이고, 늦으면 원문 요약으로 대체된다. 빠른 모델을 권장한다.
# 기본값 gemini-2.5-flash는 새로 만든 키에서 거절될 수 있다.
OPPORTUNITIES_GEMINI_MODEL=gemini-3.1-flash-lite
# 선택: 커스텀 base URL (프록시 사용 시)
# OPPORTUNITIES_GEMINI_BASE_URL=

# ===== course-plan (수강 추천 FastAPI 서버) =====
BACKEND_URL=http://127.0.0.1:8000

# ===== 공통 (로그인) =====
# 로그인 쿠키 서명용 임의 문자열. 배포 환경(Vercel)에는 반드시 설정
AUTH_SECRET=
# 수업계획서 PDF 추출 모델 (Gemini 키는 위 설정 사용)
# COURSE_PLAN_GEMINI_MODEL=gemini-2.5-flash
